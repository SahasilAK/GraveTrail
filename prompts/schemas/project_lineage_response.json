          "type": "string"
        }
      },
      "required": [
        "symbol"
      ],
      "title": "MissingContext",
      "type": "object"
    },
    "OperationRecord": {
      "additionalProperties": false,
      "properties": {
        "operation_id": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Operation Id",
          "type": "string"
        },
        "kind": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/SourceReference"
          },
          "title": "Evidence",
          "type": "array"
        },
        "reads": {
          "items": {
            "$ref": "#/$defs/ResourceReference"
          },
