      "type": "object"
    },
    "SourceReference": {
      "additionalProperties": false,
      "properties": {
        "file_id": {
          "maxLength": 500,
          "minLength": 1,
          "title": "File Id",
          "type": "string"
        },
        "content_hash": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Content Hash",
          "type": "string"
        },
        "start_offset": {
          "minimum": 0,
          "title": "Start Offset",
          "type": "integer"
        },
        "end_offset": {
          "minimum": 0,
          "title": "End Offset",
          "type": "integer"
        }
      },
      "required": [
        "file_id",
        "content_hash",
        "start_offset",
        "end_offset"
      ],
      "title": "SourceReference",
      "type": "object"
    }
