          "type": "string"
        },
        "scope": {
          "default": "",
          "title": "Scope",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "maximum": 100000,
              "minimum": 0,
              "type": "integer"
            }
          ],
          "default": "",
          "title": "Version"
        },
        "temporary": {
          "default": false,
          "title": "Temporary",
          "type": "boolean"
        }
