        "scope": {
          "default": "",
          "title": "Scope",
          "type": "string"
        },
        "order": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Order"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "context_ids": {
          "items": {
            "type": "string"
          },
          "title": "Context Ids",
          "type": "array"
        },
        "status": {
          "const": "inferred",
          "default": "inferred",
          "title": "Status",
          "type": "string"
        }
