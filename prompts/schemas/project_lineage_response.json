{
  "$defs": {
    "ContextEntry": {
      "additionalProperties": false,
      "properties": {
        "entry_id": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Entry Id",
          "type": "string"
        },
        "symbol": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Symbol",
          "type": "string"
        },
        "kind": {
          "default": "resource",
          "title": "Kind",
          "type": "string"
        },
        "scope": {
          "default": "",
          "title": "Scope",
          "type": "string"
        },
        "source_kind": {
          "enum": [
            "sql",
            "sas",
            "dbt"
          ],
          "title": "Source Kind",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/SourceReference"
          },
          "title": "Evidence",
          "type": "array"
        },
        "origin": {
          "enum": [
            "source_declared",
            "artifact_declared",
            "ai_inferred"
          ],
          "title": "Origin",
          "type": "string"
        },
        "revision": {
          "default": 0,
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "available": {
          "default": true,
          "title": "Available",
          "type": "boolean"
        }
      },
      "required": [
        "entry_id",
        "symbol",
        "source_kind",
        "evidence",
        "origin"
      ],
      "title": "ContextEntry",
      "type": "object"
    },
    "DerivationInput": {
      "additionalProperties": false,
      "properties": {
        "table": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Table",
          "type": "string"
        },
        "column": {
          "maxLength": 500,
          "title": "Column",
          "type": "string"
        },
        "role": {
          "default": "value",
          "enum": [
            "value",
            "value_selection",
            "row_filter",
            "join",
            "partition",
            "order",
            "rowset"
          ],
          "title": "Role",
          "type": "string"
        },
        "scope": {
          "default": "",
          "maxLength": 500,
          "title": "Scope",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "maximum": 100000,
              "minimum": 0,
              "type": "integer"
            }
          ],
          "default": "",
          "title": "Version"
        }
      },
      "required": [
        "table",
        "column"
      ],
      "title": "DerivationInput",
      "type": "object"
    },
    "ExtractedDerivation": {
      "additionalProperties": false,
      "properties": {
        "fact_id": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Fact Id",
          "type": "string"
        },
        "target_table": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Target Table",
          "type": "string"
        },
        "target_column": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Target Column",
          "type": "string"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/DerivationInput"
          },
          "title": "Inputs",
          "type": "array"
        },
        "expression": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/SourceReference"
          },
          "title": "Evidence",
          "type": "array"
        },
        "category": {
          "default": "unknown",
          "title": "Category",
          "type": "string"
        },
        "scope": {
          "default": "",
          "title": "Scope",
          "type": "string"
        },
        "branch": {
          "default": 0,
          "minimum": 0,
          "title": "Branch",
          "type": "integer"
        },
        "version": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "maximum": 100000,
              "minimum": 0,
              "type": "integer"
            }
          ],
          "default": "",
          "title": "Version"
        },
        "ordinal": {
          "default": 0,
          "minimum": 0,
          "title": "Ordinal",
          "type": "integer"
        },
        "status": {
          "default": "inferred",
          "enum": [
            "inferred",
            "unresolved"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "fact_id",
        "target_table",
        "target_column",
        "evidence"
      ],
      "title": "ExtractedDerivation",
      "type": "object"
    },
    "ExtractedUsage": {
      "additionalProperties": false,
      "properties": {
        "table": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Table",
          "type": "string"
        },
        "column": {
          "title": "Column",
          "type": "string"
        },
        "context": {
          "default": "value",
          "enum": [
            "value",
            "value_selection",
            "row_filter",
            "join",
            "partition",
            "order",
            "rowset"
          ],
          "title": "Context",
          "type": "string"
        },
        "scope": {
          "default": "",
          "title": "Scope",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/SourceReference"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "table",
        "column",
        "evidence"
      ],
      "title": "ExtractedUsage",
      "type": "object"
    },
    "MissingContext": {
      "additionalProperties": false,
      "properties": {
        "symbol": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Symbol",
          "type": "string"
        },
        "kind": {
          "default": "resource",
          "title": "Kind",
          "type": "string"
        },
        "scope": {
          "default": "",
          "title": "Scope",
          "type": "string"
        },
        "operation_id": {
          "default": "",
          "title": "Operation Id",
          "type": "string"
        },
        "reason": {
          "default": "missing_definition",
          "title": "Reason",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/SourceReference"
          },
          "title": "Evidence",
          "type": "array"
        },
        "status": {
          "default": "unresolved",
          "title": "Status",
          "type": "string"
        },
        "consumed_fingerprint": {
          "default": "",
