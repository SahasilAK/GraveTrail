        "superseded_fact_ids": {
          "items": {
            "type": "string"
          },
          "title": "Superseded Fact Ids",
          "type": "array"
        },
        "superseded_operation_ids": {
          "items": {
            "type": "string"
          },
          "title": "Superseded Operation Ids",
          "type": "array"
        },
        "revision": {
          "default": 0,
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "protocol_version": {
          "const": 5,
          "default": 5,
          "title": "Protocol Version",
          "type": "integer"
        }
      },
