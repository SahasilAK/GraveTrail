          "title": "Role",
          "type": "string"
        },
        "scope": {
          "default": "",
          "maxLength": 500,
          "title": "Scope",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "maximum": 100000,
              "minimum": 0,
              "type": "integer"
            }
          ],
          "default": "",
          "title": "Version"
        }
      },
      "required": [
        "table",
        "column"
      ],
      "title": "DerivationInput",
      "type": "object"
    },
    "EvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "unit_id": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Unit Id",
          "type": "string"
        }
      },
      "required": [
        "unit_id"
      ],
      "title": "EvidenceReference",
      "type": "object"
    },
    "TableRelationshipWire": {
